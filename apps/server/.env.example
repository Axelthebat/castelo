# Castelo — variáveis do servidor (apps/server)
# Nunca commite um .env real. Estes são os valores de desenvolvimento.

# HTTP
PORT=4000
HOST=0.0.0.0

# Banco (node:sqlite)
DATABASE_PATH=../data/castelo.db

# development | test | production
NODE_ENV=development

# TTL da sessão sem "lembrar de mim" (horas)
SESSION_TTL_HOURS=24

# Origem do front (Vite) — usada no CORS (dev) e no CSP
APP_ORIGIN=http://localhost:5173

# Obrigatório em produção (mínimo 16 caracteres). Em desenvolvimento há um
# default inseguro em código; NUNCA use esse default em produção.
SESSION_SECRET=
